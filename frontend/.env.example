# Copy to frontend/.env.local for local development. Never commit the real
# file — see docs/architecture/10-security.md. Production configuration is
# sourced from AWS Secrets Manager, never a .env file.

# --- Application ---------------------------------------------------------
SIGNORA_APP_URL=http://localhost:3000
SIGNORA_API_URL=http://localhost:8000

# --- Better Auth ---------------------------------------------------------
# Better Auth owns credentials and sessions; the API tier never sees them.
# Its tables live in a dedicated `auth` schema created by backend migration
# 0005, so run backend migrations before starting the frontend.
SIGNORA_AUTH_DATABASE_URL=postgresql://signora_auth:signora_auth_local_dev@localhost:5432/signora
SIGNORA_AUTH_SCHEMA=auth
BETTER_AUTH_SECRET=local-dev-secret-change-me

# --- JWT signing (ADR-0026) ----------------------------------------------
# Generate a local pair with:  npm run keys:generate
# It prints both halves to stdout rather than writing files, so key material
# never lands on disk by accident.
#
# The PRIVATE key belongs here and nowhere else. The API tier is configured
# with the PUBLIC half only and rejects a private key at readiness — that
# asymmetry is the whole point of the boundary.
SIGNORA_JWT_ISSUER=http://localhost:3000
SIGNORA_JWT_AUDIENCE=signora-api
SIGNORA_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional, but strongly recommended: supplying the public half here lets
# startup health verify the pair actually matches. Without it, a mismatched
# pair mints tokens successfully and every API call 401s with no clue why.
SIGNORA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# --- OAuth providers -----------------------------------------------------
# Both halves or neither: a half-configured provider is treated as absent so
# no sign-in button is rendered that would fail at the callback.
# With no provider configured, health reports `degraded` and nobody can sign
# in — the process is otherwise healthy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
