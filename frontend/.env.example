# Copy to frontend/.env.local for local development. Never commit the real
# file — see docs/architecture/10-security.md. Production configuration is
# sourced from AWS Secrets Manager, never a .env file.

# ⚠️ TWO VALUES BELOW ARE PER-ENVIRONMENT AND HAVE NO DEFAULT.
#
# Copying this file unedited used to point every environment — each lane, QE,
# and human review — at the SAME database, because these carried a shared
# fallback. Better Auth users written from a review session landed in whatever
# else was using it (B-104). The application now refuses to start rather than
# guessing, which is why they are marked below.
#
# docs/RUNNING.md § Running a lane allocates yours.

# --- Application ---------------------------------------------------------
# Human review uses 3000/8000. A lane uses its own row in RUNNING.md — 3300/8300
# and up. These default harmlessly: a wrong port fails immediately and loudly.
SIGNORA_APP_URL=http://localhost:3000
SIGNORA_API_URL=http://localhost:8000

# --- Better Auth ---------------------------------------------------------
# Better Auth owns credentials and sessions; the API tier never sees them.
# Its tables live in a dedicated `auth` schema created by backend migration
# 0005, so run backend migrations before starting the frontend.
#
# ⚠️ REQUIRED, no default. `signora` is the SHARED database — use it only if
# this really is the shared environment. A lane uses `signora_lane_<x>`, QE
# uses `signora_lane_qe`, human review uses `signora_review`.
SIGNORA_AUTH_DATABASE_URL=postgresql://signora_auth:signora_auth_local_dev@localhost:5432/signora
SIGNORA_AUTH_SCHEMA=auth
# ⚠️ REQUIRED, no default, and a security property. The value below is
# committed to this repository: every clone using it signs JWTs any other clone
# can forge. Generate your own — `openssl rand -base64 32` — and never reuse it
# between environments.
BETTER_AUTH_SECRET=local-dev-secret-change-me

# --- JWT signing (ADR-0026) ----------------------------------------------
# Generate a local pair with:  npm run keys:generate
# It prints both halves to stdout rather than writing files, so key material
# never lands on disk by accident.
#
# The PRIVATE key belongs here and nowhere else. The API tier is configured
# with the PUBLIC half only and rejects a private key at readiness — that
# asymmetry is the whole point of the boundary.
SIGNORA_JWT_ISSUER=http://localhost:3000
SIGNORA_JWT_AUDIENCE=signora-api
SIGNORA_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional, but strongly recommended: supplying the public half here lets
# startup health verify the pair actually matches. Without it, a mismatched
# pair mints tokens successfully and every API call 401s with no clue why.
SIGNORA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# --- Sign-in methods -----------------------------------------------------
# Authentication methods are configuration; the authenticated session is not
# (ADR-0033). Whichever method somebody uses, Better Auth issues one session
# shape and the JWT minted from it carries no record of which — so nothing in
# the API can tell them apart.

# Email + password. On unless set to `false`. This is the method that needs no
# external service, which is why a local install can always sign in.
SIGNORA_AUTH_PASSWORD_ENABLED=true

# Where verification and password-reset links go. `console` writes them to
# this process's stdout — a real token and a real link, delivered somewhere a
# developer can reach. It REFUSES TO START in production, because a reset link
# in a production log is a credential in a log file.
SIGNORA_AUTH_EMAIL_TRANSPORT=console

# OAuth providers. Both halves or neither: a half-configured provider is
# treated as absent so no sign-in button is rendered that would fail at the
# callback. With none configured, the sign-in page simply shows no provider
# buttons — password sign-in is unaffected and health stays `ok`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
