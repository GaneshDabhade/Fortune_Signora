# Copy to backend/.env for local development. Never commit the real .env —
# see docs/architecture/10-security.md on secrets management. Production
# configuration is sourced from AWS Secrets Manager, never a .env file.

SIGNORA_ENVIRONMENT=local

# ⚠️ PER-ENVIRONMENT, and it has no default.
#
# The logical index at the end is the isolation boundary, and `docs/RUNNING.md`
# allocates one per environment. **Index 0 belongs to human review.** A lane
# that leaves this unedited joins review's queue — and Redis carries the ARQ
# job queue and the outbox relay, so sharing an index means one environment's
# workers consume the other's jobs.
#
# It used to default to index 0 in code, which made the allocation table
# advisory. It now refuses (B-104's class, applied to queues).
SIGNORA_REDIS_URL=redis://localhost:6379/0

# One variable, two credentials — read this before changing it.
#
# Running migrations needs the OWNER role: they CREATE ROLE, GRANT, and
# REVOKE. Running the API needs `signora_app`, which is NOSUPERUSER and
# NOBYPASSRLS and therefore actually subject to Row-Level Security
# (migration 0002, docs/architecture/11-tenancy.md).
#
# The same variable name carries a different identity per process, and that
# separation IS the tenancy model rather than a deployment preference
# (CLAUDE.md §8, backend/migrations/env.py, infra/docker-compose.prod.yml).
#
# This file configures the RUNTIME, so the value below is the runtime's.
SIGNORA_DATABASE_URL=postgresql+asyncpg://signora_app:signora_app_local_dev@localhost:5432/signora

# The MIGRATION credential, and nothing here needs you to export it:
#   postgresql+asyncpg://signora:signora@localhost:5432/signora
# `make migrate` supplies it explicitly from OWNER_DATABASE_URL (Makefile),
# so `alembic upgrade head` works without this file carrying the owner.
#
# B-243, 2026-08-11 — this line used to hold the owner as the default, and
# the comment justifying it said "locally the value below is the admin one so
# `alembic upgrade head` works out of the box". That had stopped being true:
# the Makefile passes the owner itself, so the default was defended by a need
# something else had already absorbed. Meanwhile every local API run bypassed
# RLS, and Lane A rendered one customer's organization name in another
# customer's browser. A hazard documented in a comment that asks the reader
# to "override it when running the API" is not a guard — it is documentation
# pretending to be code (CLAUDE.md §2), and it failed the first time
# somebody ran the file as shipped.

# --- JWT verification (ADR-0026) -----------------------------------------
# This tier VERIFIES tokens; it never issues them. Configure the PUBLIC half
# only — the private key lives in the frontend. A private key supplied here
# is rejected at readiness rather than silently accepted, because it would
# make the API able to mint tokens it accepts.
#
# Must match the frontend's SIGNORA_JWT_ISSUER / SIGNORA_JWT_AUDIENCE
# exactly; a mismatch rejects every token with a generic 401.
SIGNORA_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
SIGNORA_JWT_ISSUER=http://localhost:3000
SIGNORA_JWT_AUDIENCE=signora-api
